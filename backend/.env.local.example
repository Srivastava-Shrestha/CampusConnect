# Local "just let me click around" configuration.
#
# Copy this to .env.local and run the API with:
#   uv run python scripts/dev_seed.py
#   uv run --env-file .env.local uvicorn main:app --reload --port 8000
#
# Values here are real environment variables, so they take priority over
# whatever is in .env. Keep your ANTHROPIC_API_KEY in .env - it is read from
# there and does not need to be repeated.
#
# This points at a throwaway SQLite file, not Postgres. It is for exercising
# the UI and the AI module by hand. Real backend work still needs Postgres and
# the alembic migrations.

DATABASE_URL=sqlite+aiosqlite:///./dev.db
TEST_DATABASE_URL=sqlite+aiosqlite:///./dev_test.db
JWT_SECRET_KEY=local-dev-secret-not-for-production
JWT_ALGORITHM=HS256
FRONTEND_URL=http://localhost:5173

# Required by Settings for the certificate feature. Placeholders are fine
# unless you are actually testing certificate upload/download.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=local-dev-not-used
AWS_ACCESS_KEY_ID=local-dev-not-used
AWS_SECRET_ACCESS_KEY=local-dev-not-used

# Required by Settings for password reset mail. Port 1025 matches MailHog if
# you happen to be running it; nothing in the AI module sends mail.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=local-dev-not-used
SMTP_PASSWORD=local-dev-not-used
MAIL_FROM=noreply@localhost
